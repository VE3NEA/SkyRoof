<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows to match SkyRoof, which DopplerRamp now lives in -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <IsPackable>false</IsPackable>
    <RootNamespace>VE3NEA.Dsp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyRoof\SkyRoof.csproj" />
  </ItemGroup>

  <!-- SkyRoof consumes VE3NEA.SkyTlm as a vendored assembly, and an assembly reference does not flow to a
       referencing project the way a project reference would, so tests that name SkyTlm types have to point
       at the same copy themselves. -->
  <ItemGroup>
    <Reference Include="VE3NEA.SkyTlm">
      <HintPath>..\Vendor\VE3NEA.SkySignals\VE3NEA.SkyTlm.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VE3NEA.SkyFM">
      <HintPath>..\Vendor\VE3NEA.SkySignals\VE3NEA.SkyFM.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VE3NEA.Dsp">
      <HintPath>..\Vendor\VE3NEA.Dsp\VE3NEA.Dsp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
